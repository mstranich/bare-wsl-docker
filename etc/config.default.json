{
  "schemaVersion": 1,
  "distributionName": "bare-docker",
  "paths": {
    "distributionDirectory": "../runtime/bare-docker",
    "dataVhdx": "../runtime/data.vhdx",
    "downloads": "../runtime/downloads",
    "logs": "../runtime/logs",
    "backups": "../runtime/backups",
    "clientCertificates": "../runtime/certs/client"
  },
  "storage": {
    "maximumSizeGB": 256,
    "label": "dockerd-data",
    "mountPoint": "/mnt/docker-data",
    "dockerDataRoot": "/mnt/docker-data/docker"
  },
  "startupTask": {
    "name": "Docker Engine for WSL",
    "delaySeconds": 30
  },
  "windowsCli": {
    "installWithWinget": true,
    "tlsPort": 2376,
    "setEnvironmentVariables": true,
    "composeExecutable": "docker-compose.exe"
  },
  "tls": {
    "validityDays": 3650
  },
  "alpine": {
    "mirror": "https://dl-cdn.alpinelinux.org/alpine",
    "releaseChannel": "latest-stable",
    "architecture": "x86_64",
    "version": null,
    "branch": null,
    "rootfsUrl": null,
    "rootfsSha256": null
  }
}
